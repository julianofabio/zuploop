{
  "name": "zuploop",
  "private": true,
  "description": "ZupLoop.com: classic pastimes for adults, in Portuguese, Spanish and English.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @zuploop/web dev",
    "build": "pnpm --filter @zuploop/web build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test && pnpm format:check",
    "lint:styles": "node scripts/lint-styles.mjs",
    "test:e2e": "pnpm --filter @zuploop/web test:e2e",
    "test:html": "pnpm --filter @zuploop/web test:html",
    "build:hidden": "pnpm --filter @zuploop/web build:hidden",
    "test:lighthouse": "pnpm --filter @zuploop/web test:lighthouse"
  },
  "devDependencies": {
    "@zuploop/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
