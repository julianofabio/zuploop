# Variáveis do ambiente local (FDD 001 §6.8). Copie para .env e troque os valores:
#   cp .env.example .env
# O .env nunca vai para o Git. Aqui só valores falsos. Em produção, as mesmas variáveis
# viram Secret e ConfigMap no Kubernetes (docs/runbooks/publicar.md).

# Banco (db e api). POSTGRES_PASSWORD é segredo.
POSTGRES_USER=zuploop
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=zuploop

# API
API_ENV=local
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:8080

# Site: viram o /config.json público (nunca coloque segredo aqui)
PUBLIC_ENVIRONMENT=local
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_ANALYTICS_ENABLED=false

# Versão publicada (api e web); no formato AAAA.MM.DD-<commit> nas imagens de produção
APP_VERSION=local

# Só para testes: mostra o jogo de exemplo, que é oculto em produção
ZUPLOOP_SHOW_HIDDEN_GAMES=false
