{
  "name": "@zuploop/game-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/manifest.ts",
    "./Game": "./src/Game.tsx"
  },
  "imports": {
    "#load": {
      "react-server": "./src/load.server.ts",
      "default": "./src/load.ts"
    }
